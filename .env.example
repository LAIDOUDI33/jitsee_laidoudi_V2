# ============================================================================
# ALVISION — Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================================

# ---- Application ----
NODE_ENV=production

# ---- Authentication ----
# REQUIRED: Generate a strong secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=your-strong-jwt-secret-here

# JWT token expiration (e.g. "7d", "24h", "1h")
JWT_EXPIRES_IN=7d

# ---- Database ----
# SQLite file path (relative to project root)
DATABASE_URL=file:./db/alvision.db

# ---- WebSocket Chat Service ----
# Leave empty for same-origin (gateway handles routing)
# Set to ws://host:3010 for direct connection
NEXT_PUBLIC_WS_URL=

# ---- Security ----
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com

# ---- AI / LLM (optional) ----
# Used by z-ai-web-dev-sdk for AI features
# ZAI_API_KEY=
