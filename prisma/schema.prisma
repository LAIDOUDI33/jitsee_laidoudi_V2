generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  name          String
  avatar        String?
  role          String    @default("participant") // superadmin, orgadmin, teamadmin, host, participant, guest
  organizationId String?
  isActive      Boolean   @default(true)
  mfaEnabled    Boolean   @default(false)
  lastLogin     DateTime?
  resetTokenHash  String?
  resetTokenExpiry DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  teamMembers  TeamMember[]
  hostedMeetings Meeting[]
  meetings     MeetingParticipant[]
  messages     Message[]
  auditLogs    AuditLog[]
  actionItems  ActionItem[]
  files        File[]
  apiKeys      ApiKey[]
  templates    Template[]
  sessions     Session[]
  aiConversations AiConversation[]
  polls        Poll[]

  @@index([organizationId])
  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model Organization {
  id          String   @id @default(uuid())
  name        String   @unique
  domain      String?
  plan        String   @default("free") // free, pro, enterprise
  maxUsers    Int      @default(50)
  maxMeetingRooms Int   @default(20)
  settings    String   @default("{}") // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  teams       Team[]
  meetings    Meeting[]
  events      Event[]
  templates   Template[]
}

model Team {
  id             String   @id @default(uuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channels       Channel[]
  members        TeamMember[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("member") // admin, member
  joinedAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  teamId    String
  type      String   @default("text") // text, video, announcement
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  messages  Message[]
  files    File[]

  @@index([teamId])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  channelId String?
  meetingId String?
  userId    String
  type      String   @default("text") // text, system, file, reaction
  edited    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([meetingId])
  @@index([userId])
  @@index([createdAt])
}

model Meeting {
  id                String   @id @default(uuid())
  title             String
  meetingId         String   @unique // public meeting ID like "abc-def-ghi"
  password          String?  // DEPRECATED — retained for backward compat; do not write new values
  passwordHash      String?  // scrypt hash of meeting password (for join protection)
  settings          String?  @default("{\"duration\":60}") // JSON for scheduling settings
  hostId            String?
  organizationId    String?
  type              String   @default("instant") // instant, scheduled, recurring, personal
  status            String   @default("active") // scheduled, active, ended, expired
  maxParticipants   Int      @default(100)
  waitingRoom       Boolean  @default(false)
  recordingEnabled  Boolean  @default(true)
  transcriptionEnabled Boolean @default(true)
  aiAssistantEnabled Boolean @default(true)
  notes             String   @default("{}") // JSON: { title, content (HTML) }
  startTime         DateTime?
  endTime           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  host        User?               @relation(fields: [hostId], references: [id], onDelete: SetNull)
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  messages    Message[]
  recordings  Recording[]
  transcripts Transcript[]
  summaries   MeetingSummary[]
  polls       Poll[]
  actionItems ActionItem[]

  @@index([hostId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([startTime])
  @@index([createdAt])
}

model MeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  role      String   @default("participant") // host, cohost, participant
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@index([meetingId])
}

model Recording {
  id        String   @id @default(uuid())
  meetingId String
  url       String   // path to recording file
  duration  Int      @default(0) // seconds
  size      Int      @default(0) // bytes
  format    String   @default("mp4")
  createdAt DateTime @default(now())

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Transcript {
  id          String   @id @default(uuid())
  meetingId   String
  speakerName String
  speakerId   String?
  text        String
  language    String   @default("en")
  confidence  Float    @default(0)
  timestamp   Int      @default(0) // ms offset
  createdAt   DateTime @default(now())

  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingSummary {
  id          String   @id @default(uuid())
  meetingId   String
  summary     String
  keyTopics   String   @default("[]") // JSON array
  decisions   String   @default("[]")
  risks       String   @default("[]")
  duration    Int      @default(0)
  participantCount Int  @default(0)
  createdAt   DateTime @default(now())

  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model ActionItem {
  id          String   @id @default(uuid())
  content     String
  ownerId     String
  meetingId   String?
  dueDate     DateTime?
  priority    String   @default("medium") // low, medium, high, critical
  status      String   @default("pending") // pending, in_progress, completed, overdue
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  meeting     Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([meetingId])
  @@index([status])
}

model Poll {
  id         String   @id @default(uuid())
  meetingId  String
  question   String
  options    String   @default("[]") // JSON array of option strings
  results    String   @default("{}") // JSON object { "0": 3, "1": 5, ... } option index -> vote count
  status     String   @default("active") // active, ended
  multiSelect Boolean @default(false)
  votes      String   @default("{}") // JSON object { "userId": [optionIndices], ... }
  createdBy  String
  createdAt  DateTime @default(now())

  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  creator    User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([createdBy])
}

model Event {
  id                String   @id @default(uuid())
  title             String
  description       String?
  organizationId   String
  type              String   @default("webinar") // webinar, townhall, conference, livestream
  status            String   @default("upcoming") // upcoming, live, ended, cancelled
  startTime         DateTime
  endTime           DateTime?
  maxAttendees      Int      @default(500)
  registrationEnabled Boolean @default(true)
  recordingEnabled  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registrations  EventRegistration[]

  @@index([organizationId])
  @@index([status])
  @@index([startTime])
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  email     String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
}

model File {
  id          String   @id @default(uuid())
  name        String
  path        String
  size        Int      @default(0)
  mimeType    String?
  uploadedBy  String
  channelId   String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  uploader    User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([uploadedBy])
  @@index([channelId])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  resource      String
  resourceId    String?
  details       String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  key         String    @unique
  userId      String
  permissions String    @default("[]")
  isActive    Boolean   @default(true)
  lastUsed    DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Template {
  id              String   @id @default(uuid())
  name            String
  description     String   @default("")
  duration        String   @default("30m")
  maxParticipants Int      @default(10)
  settings        String   @default("[]")  // JSON array of enabled features
  agenda          String   @default("")
  gradient        String   @default("from-sky-500 to-blue-500")
  iconBg          String   @default("from-sky-500 to-blue-600")
  isBuiltin       Boolean  @default(false)
  createdById     String
  organizationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([organizationId])
}

// ── Chat Service Persistence Models ─────────────────────────────────────

model ChatChannel {
  id             String   @id @default(uuid())
  name           String
  organizationId String?
  createdAt      DateTime @default(now())

  messages ChatMessage[]
  members  ChatChannelMember[]

  @@index([organizationId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  channelId  String
  senderId   String
  senderName String
  content    String
  timestamp  String
  avatar     String?
  status     String   @default("sent") // sent, delivered, read
  reactions  String   @default("{}") // JSON: Record<string, number>
  createdAt  DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([createdAt])
}

model ChatChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

// ── Login Session Tracking ──────────────────────────────────────────

model Session {
  id           String    @id @default(uuid())
  userId       String
  deviceInfo   String?
  ipAddress    String?
  lastActivity DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── AI Conversation Memory ──────────────────────────────────────────

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("New Chat")
  model     String   @default("gpt-4o-mini")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiConversationMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model AiConversationMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // user, assistant, system
  content        String
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// ── Notifications ──────────────────────────────────────────────────

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   // meeting-invite, meeting-soon, mention, recording-ready, ai-summary, file-shared, member-joined, security-alert, maintenance, system-update, message, general
  title       String
  description String?
  read        Boolean  @default(false)
  pinned      Boolean  @default(false)
  actionUrl   String?
  metadata    String   @default("{}") // JSON for extra data
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
}